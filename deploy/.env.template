# RoofEstimate environment configuration
# Copy this to ../.env on the EC2 instance and fill in your keys.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Anthropic Claude key — used for Vision LLM pitch estimation
ANTHROPIC_API_KEY=

# Google Maps Platform key with Geocoding + Solar APIs enabled
# (used for rooftop-precision geocoding, Solar API cross-check, and
#  Google Static satellite imagery for the cropped Vision LLM input)
GOOGLE_VISION_API_KEY=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Pipeline mode for the Solar API stance:
#   off     — pure build path (MS Buildings + Vision LLM pitch). No Solar.
#   fusion  — validated-build (build path; Solar tiebreaker on >15% divergence).  ← DEFAULT
#   primary — Solar API primary, build path as fallback.
SOLAR_MODE=fusion

# Mapbox token — alternative geocoder if Google Geocoding unavailable
# MAPBOX_TOKEN=

# Bing Maps key — alternative aerial imagery if ESRI unavailable
# BING_MAPS_KEY=

# Per-pipeline-call debug artifacts written to outputs/debug/<slug>/
# MEASURE_DEBUG=
